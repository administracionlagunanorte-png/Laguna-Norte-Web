    +'<div style="font-size:3.2rem;font-family:monospace;font-weight:700;color:var(--navy);letter-spacing:.3em;line-height:1">'+ pin +'</div>'
    +'<p style="font-size:.78rem;color:var(--slate);margin-top:8px">'+esc(r.email)+'</p>'
    +'</div>'
    +'<div id="pinEmailStatus" style="text-align:center;font-size:.84rem;padding:10px;border-radius:10px;background:#f8fafc;margin-bottom:16px">📤 Enviando correo automático...</div>'
    +'<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">'
    +'<button class="bsave" style="padding:11px;border-radius:10px;font-size:.88rem" id="pinCopyBtn2" onclick="copyPin2(this.dataset.p)" data-p="'+pin+'">📋 Copiar PIN</button>'
    +'<a style="display:flex;align-items:center;justify-content:center;gap:6px;background:#dbeafe;color:#1d4ed8;font-weight:600;font-size:.88rem;border-radius:10px;padding:11px;text-decoration:none" href="'+mailto+'">✉️ Enviar desde mi correo</a>'
    +'</div>'
    +'<p style="font-size:.75rem;color:var(--slate);margin-top:12px;text-align:center">Si el envío automático falla, usa el botón azul para enviar desde tu cliente de correo.</p>';

  openModal('pinModal');
