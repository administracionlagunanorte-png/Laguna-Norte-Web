function sendPinEmail(resident, pin){
  /* Uses FormSubmit.co — sends directly to resident email, no API key needed */
  var payload = {
    _subject:   'Tu PIN de acceso - Portal Condominio Laguna Norte',
    _template:  'table',
    _captcha:   'false',
    name:       resident.nombre + ' ' + resident.apellido,
    email:      resident.email,
    Residente:  resident.nombre + ' ' + resident.apellido,
    Casa:       resident.casa,
    'Correo de acceso': resident.email,
    'PIN de acceso':    pin,
    Instrucciones: 'Ingresa al portal con tu correo y este PIN de 4 digitos. Guardalo en un lugar seguro.'
  };
  return fetch('https://formsubmit.co/ajax/' + encodeURIComponent(resident.email), {
    method:  'POST',
    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
    body:    JSON.stringify(payload)
  }).then(function(r){
    if (!r.ok) throw new Error('HTTP ' + r.status);
    return r.json();
  });
}

