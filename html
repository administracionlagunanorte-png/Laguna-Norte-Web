document.getElementById('regSubmitBtn').addEventListener('click', function(){
  var nombre   = document.getElementById('regNombre').value.trim();
  var apellido = document.getElementById('regApellido').value.trim();
  var casa     = document.getElementById('regCasa').value.trim();
  var email    = document.getElementById('regEmail').value.trim().toLowerCase();
  var err      = document.getElementById('regErr');
  err.innerHTML = '';

  // Clear error states
  ['regNombre','regApellido','regCasa','regEmail'].forEach(function(id){
    document.getElementById(id).classList.remove('err');
  });

  // Validate required
  var missing = [];
  if (!nombre)   { missing.push('regNombre');   }
  if (!apellido) { missing.push('regApellido'); }
  if (!casa)     { missing.push('regCasa');     }
  if (!email)    { missing.push('regEmail');    }
  if (missing.length){
    missing.forEach(function(id){ document.getElementById(id).classList.add('err'); });
    err.innerHTML = '⚠️ Todos los campos son obligatorios.';
    return;
  }

  // Validate email format
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){
    document.getElementById('regEmail').classList.add('err');
    err.innerHTML = '⚠️ Ingresa un correo electrónico válido.';
    return;
  }

  // Validate no duplicate email
  var exists = residents.find(function(r){ return r.email === email; });
  if (exists){
    document.getElementById('regEmail').classList.add('err');
    err.innerHTML = '⚠️ Este correo ya está registrado. Inicia sesión o contacta a la administración.';
    return;
  }

  // Save with pending status (admin must approve)
  var newResident = {
    id:       'r' + Date.now(),
    nombre:   nombre,
    apellido: apellido,
    casa:     casa,
    email:    email,
    pin:      '',        // assigned by admin on approval
    status:   'pending', // pending | active | blocked
    createdAt: new Date().toISOString().slice(0,10)
  };
  residents.push(newResident);
  saveResidents();

  // Show success
  document.getElementById('regForm').style.opacity = '0.4';
  document.getElementById('regForm').style.pointerEvents = 'none';
  document.getElementById('regSuccess').classList.add('show');
  if (isAdmin) renderResidents();
});

