  });
};

window.copyPin2 = function(btn){
  var pin = btn ? btn.dataset.p : '';
  if (navigator.clipboard){ navigator.clipboard.writeText(String(pin)); }
  else { var t=document.createElement('textarea'); t.value=String(pin); document.body.appendChild(t); t.select(); document.execCommand('copy'); document.body.removeChild(t); }
  if (btn){ btn.textContent='✓ Copiado'; setTimeout(function(){ btn.textContent='📋 Copiar PIN'; },1800); }
};

window.blockResident = function(id){
  var r = residents.find(function(x){ return x.id===id; });
  if (!r) return;
  r.status = 'blocked';
  saveResidents(); renderResidents();
  toast('Acceso bloqueado: ' + r.nombre + ' ' + r.apellido, false);
};
window.unblockResident = function(id){
  var r = residents.find(function(x){ return x.id===id; });
  if (r){ r.status='active'; saveResidents(); renderResidents(); toast('Acceso reactivado.', true); }
};
window.deleteResident = function(id){
  var r = residents.find(function(x){ return x.id===id; });
  if (!r) return;

  /* Inject confirm modal if not present */
  if (!document.getElementById('delResModal')){
    var el = document.createElement('div');
    el.className = 'modal';
    el.id = 'delResModal';
    el.innerHTML =
      '<div class="mbox" style="max-width:400px;text-align:center">'
      +'<div style="font-size:2.5rem;margin-bottom:12px">🗑️</div>'
      +'<h2 class="mtitle" style="margin-bottom:6px">Eliminar residente</h2>'
      +'<p class="msub" id="delResMsg"></p>'
      +'<div style="display:flex;gap:10px;margin-top:20px">'
      +'<button class="bdel" id="delResConfirm" style="flex:1;padding:12px;border-radius:10px;font-size:.92rem">Sí, eliminar</button>'
      +'<button class="bcancel" id="delResCancel" style="flex:1;padding:12px;border-radius:10px">Cancelar</button>'
      +'</div>'
      +'</div>';
    document.body.appendChild(el);
    document.getElementById('delResCancel').addEventListener('click', function(){ closeModal('delResModal'); });
  }

  document.getElementById('delResModal').dataset.rid = id;
  document.getElementById('delResMsg').textContent = '¿Eliminar permanentemente a ' + r.nombre + ' ' + r.apellido + ' (Casa ' + r.casa + ')? Esta acción no se puede deshacer.';

  document.getElementById('delResConfirm').onclick = function(){
    var rid = document.getElementById('delResModal').dataset.rid;
    residents = residents.filter(function(x){ return x.id!==rid; });
    saveResidents();
    closeModal('delResModal');
    renderResidents();
    toast('Residente eliminado.', false);
  };

  openModal('delResModal');
};
window.editResident = function(id){
  var r = residents.find(function(x){ return x.id===id; });
  if (!r) return;

  /* Inject edit modal if not present */
  if (!document.getElementById('editResModal')){
    var el = document.createElement('div');
    el.className = 'modal';
    el.id = 'editResModal';
    el.innerHTML =
      '<div class="mbox" style="max-width:520px">'
      +'<button class="mclose" id="closeEditRes">×</button>'
      +'<h2 class="mtitle" style="margin-bottom:4px">Editar residente</h2>'
      +'<p class="msub" id="editResSubtitle"></p>'
      +'<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px">'
      +'<div><label style="font-size:.75rem;font-weight:700;color:var(--navy);text-transform:uppercase;letter-spacing:.05em;display:block;margin-bottom:5px">Nombre</label>'
      +'<input class="minput" id="erNombre" style="margin:0" placeholder="Nombre"></div>'
      +'<div><label style="font-size:.75rem;font-weight:700;color:var(--navy);text-transform:uppercase;letter-spacing:.05em;display:block;margin-bottom:5px">Apellido</label>'
      +'<input class="minput" id="erApellido" style="margin:0" placeholder="Apellido"></div>'
      +'</div>'
      +'<div style="margin-bottom:14px"><label style="font-size:.75rem;font-weight:700;color:var(--navy);text-transform:uppercase;letter-spacing:.05em;display:block;margin-bottom:5px">Casa / Unidad</label>'
      +'<input class="minput" id="erCasa" style="margin:0" placeholder="Casa o Unidad"></div>'
      +'<div style="margin-bottom:14px"><label style="font-size:.75rem;font-weight:700;color:var(--navy);text-transform:uppercase;letter-spacing:.05em;display:block;margin-bottom:5px">Correo electrónico</label>'
      +'<input class="minput" id="erEmail" type="email" style="margin:0" placeholder="correo@ejemplo.com"></div>'
      +'<div style="margin-bottom:18px"><label style="font-size:.75rem;font-weight:700;color:var(--navy);text-transform:uppercase;letter-spacing:.05em;display:block;margin-bottom:5px">PIN de acceso (4 dígitos)</label>'
      +'<input class="minput" id="erPin" maxlength="4" inputmode="numeric" style="margin:0;letter-spacing:.2em;font-family:monospace;font-size:1.1rem" placeholder="Dejar vacío para no cambiar"></div>'
      +'<div class="merr" id="erErr"></div>'
      +'<div style="display:flex;gap:10px">'
      +'<button class="bsave" id="erSaveBtn" style="flex:1;padding:12px;border-radius:10px">Guardar cambios</button>'
      +'<button class="bcancel" id="erCancelBtn" style="flex:1;padding:12px;border-radius:10px">Cancelar</button>'
      +'</div>'
      +'</div>';
    document.body.appendChild(el);

    document.getElementById('closeEditRes').addEventListener('click', function(){ closeModal('editResModal'); });
    document.getElementById('erCancelBtn').addEventListener('click', function(){ closeModal('editResModal'); });
    document.getElementById('erSaveBtn').addEventListener('click', function(){
      var rid    = document.getElementById('editResModal').dataset.rid;
      var res    = residents.find(function(x){ return x.id===rid; });
      if (!res) return;
      var nombre   = document.getElementById('erNombre').value.trim();
      var apellido = document.getElementById('erApellido').value.trim();
      var casa     = document.getElementById('erCasa').value.trim();
      var email    = document.getElementById('erEmail').value.trim().toLowerCase();
      var pin      = document.getElementById('erPin').value.trim();
      var err      = document.getElementById('erErr');
      err.textContent = '';
      if (!nombre || !apellido || !casa || !email){
        err.textContent = '⚠️ Todos los campos excepto PIN son obligatorios.'; return;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){
        err.textContent = '⚠️ Correo inválido.'; return;
      }
      var dup = residents.find(function(x){ return x.email===email && x.id!==rid; });
      if (dup){ err.textContent = '⚠️ Ese correo ya está en uso por otro residente.'; return; }
      if (pin && !/^\d{4}$/.test(pin)){ err.textContent = '⚠️ El PIN debe ser exactamente 4 dígitos.'; return; }
      res.nombre   = nombre;
      res.apellido = apellido;
      res.casa     = casa;
      res.email    = email;
      if (pin) res.pin = pin;
      saveResidents();
      closeModal('editResModal');
      renderResidents();
      toast('Residente actualizado correctamente.', true);
    });
  }

  /* Populate and open */
  document.getElementById('editResModal').dataset.rid = r.id;
  document.getElementById('editResSubtitle').textContent = r.nombre + ' ' + r.apellido + ' · Casa ' + r.casa;
  document.getElementById('erNombre').value   = r.nombre;
  document.getElementById('erApellido').value = r.apellido;
  document.getElementById('erCasa').value     = r.casa;
  document.getElementById('erEmail').value    = r.email;
  document.getElementById('erPin').value      = '';
  document.getElementById('erErr').textContent = '';
  openModal('editResModal');
};

