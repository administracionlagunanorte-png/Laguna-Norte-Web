function renderResidents(){
  var search  = (document.getElementById('resSearch') ? document.getElementById('resSearch').value.toLowerCase() : '');
  var badge   = document.getElementById('resBadge');
  var list    = document.getElementById('residentsList');
  var filtered = residents.filter(function(r){
    return !search
      || (r.nombre+' '+r.apellido).toLowerCase().includes(search)
      || r.casa.toLowerCase().includes(search)
      || r.email.toLowerCase().includes(search);
  });

  var pending = residents.filter(function(r){ return r.status==='pending'; }).length;
  if (badge) badge.textContent = residents.length + ' registro' + (residents.length!==1?'s':'') + (pending?' · '+pending+' pendiente'+(pending!==1?'s':''):'');

  if (!filtered.length){
    list.innerHTML = '<p style="padding:20px;color:var(--slate)">No se encontraron residentes.</p>';
    return;
  }

  var statusLabel = { pending:'⏳ Pendiente', active:'✅ Activo', blocked:'🚫 Bloqueado' };
  var statusColor = { pending:'background:#fef3c7;color:#92400e', active:'background:#dcfce7;color:#166534', blocked:'background:#fee2e2;color:#991b1b' };

  list.innerHTML = '<table class="atable" style="font-size:.84rem"><thead><tr>'
    +'<th>Nombre</th><th>Casa</th><th>Correo</th><th>PIN</th><th>Estado</th><th>Registro</th><th>Acciones</th>'
    +'</tr></thead><tbody>'
    + filtered.map(function(r){
        var rid = esc(r.id);
        return '<tr>'
          +'<td><strong>'+esc(r.nombre)+' '+esc(r.apellido)+'</strong></td>'
          +'<td>'+esc(r.casa)+'</td>'
          +'<td style="font-size:.8rem">'+esc(r.email)+'</td>'
          +'<td style="font-family:monospace;letter-spacing:.1em">'+(r.pin||'<span style="color:var(--slate)">—</span>')+'</td>'
          +'<td><span style="padding:3px 10px;border-radius:20px;font-size:.72rem;font-weight:700;'+statusColor[r.status]+'">'+statusLabel[r.status]+'</span></td>'
          +'<td style="font-size:.78rem;color:var(--slate)">'+esc(r.createdAt)+'</td>'
          +'<td style="white-space:nowrap">'
          +(r.status==='pending'
            ? '<button class="bedit res-action" data-action="approve" data-id="'+rid+'">Aprobar</button>'
            : '')
          +(r.status==='active'
            ? '<button class="bedit res-action" data-action="block" data-id="'+rid+'" style="background:#fef3c7;color:#92400e">Bloquear</button>'
            : '')
          +(r.status==='blocked'
            ? '<button class="bedit res-action" data-action="unblock" data-id="'+rid+'">Activar</button>'
            : '')
          +' <button class="bedit res-action" data-action="edit" data-id="'+rid+'" style="margin-left:2px">Editar</button>'
          +' <button class="bdel res-action" data-action="delete" data-id="'+rid+'">Eliminar</button>'
          +'</td></tr>';
      }).join('')
    +'</tbody></table>';

  /* Delegate all button clicks via data attributes — avoids inline onclick quote issues */
  list.querySelectorAll('.res-action').forEach(function(btn){
    btn.addEventListener('click', function(){
      var id  = this.dataset.id;
      var act = this.dataset.action;
      if      (act === 'approve') approveResident(id);
      else if (act === 'block')   blockResident(id);
      else if (act === 'unblock') unblockResident(id);
      else if (act === 'edit')    editResident(id);
      else if (act === 'delete')  deleteResident(id);
    });
  });
}

