          <button class="btn-rlogin" id="regSubmitBtn" style="background:linear-gradient(135deg,#059669,#10b981)">Enviar solicitud</button>
          <p style="text-align:center;font-size:.78rem;color:var(--slate);margin-top:12px">La administración revisará tu solicitud y te notificará por correo.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal" id="resultModal">
  <div class="mbox wide">
    <button class="mclose" id="closeResult">×</button>
    <h2 class="mtitle" id="resTitle"></h2>
    <div id="resContent" style="margin-top:14px"></div>
    <canvas id="voteChart" style="margin-top:22px;max-height:200px"></canvas>
  </div>
</div>

<script>
(function() {
"use strict";

/* ── SMOOTH NAV ── */
var PROTECTED = ['documentos','votaciones','contacto'];
window.navTo = function(id){
  if (PROTECTED.indexOf(id) !== -1 && !isResident){
    window._pendingNav = id;
    openModal('resLoginModal');
    return;
  }
  var el = document.getElementById(id);
  if (!el) return;
  el.style.display = 'block';
  setTimeout(function(){
    var top = el.getBoundingClientRect().top + window.scrollY - 78;
    window.scrollTo({ top: top, behavior: 'smooth' });
  }, 60);
};

var posts = JSON.parse(localStorage.getItem('ln_posts') || 'null') || [
  { id:'p1', title:'Corte de suministro electrico', category:'seguridad', urgent:true, important:false, date:'2026-04-10', excerpt:'Mantenimiento electrico el viernes 11 de abril, 09:00-14:00 hrs. Se recomienda precaucion.' },
  { id:'p2', title:'Asamblea General Ordinaria 2026', category:'reunion', urgent:false, important:true, date:'2026-04-05', excerpt:'Convocatoria el 28 de abril, 19:30 hrs, Salon de Eventos Club House. Temas: presupuesto, areas verdes y mejoras.' },
  { id:'p3', title:'Nuevo sistema de acceso vehicular', category:'seguridad', urgent:false, important:false, date:'2026-04-01', excerpt:'Desde el 15 de abril, nuevo sistema de reconocimiento de patentes en porteria principal.' },
  { id:'p4', title:'Mantenimiento de la laguna', category:'mantenimiento', urgent:false, important:false, date:'2026-03-28', excerpt:'Trabajos de mantencion preventiva en la laguna Crystal los dias 5 y 6 de abril. Acceso restringido.' }
];
var docs = JSON.parse(localStorage.getItem('ln_docs') || 'null') || [
  { id:'d1', name:'Acta Asamblea Ordinaria Marzo 2026', category:'actas', year:'2026', status:'current', date:'2026-03-15', size:'245 KB' },
  { id:'d2', name:'Reglamento Interno de Convivencia v2.1', category:'reglamentos', year:'2025', status:'current', date:'2025-06-10', size:'1.2 MB' },
  { id:'d3', name:'Balance Financiero 2025', category:'finanzas', year:'2025', status:'current', date:'2026-01-20', size:'580 KB' },
  { id:'d4', name:'Plan de Emergencia y Evacuacion v4.0', category:'emergencia', year:'2026', status:'current', date:'2026-03-01', size:'820 KB' },
  { id:'d5', name:'Acta Asamblea Extraordinaria Dic 2025', category:'actas', year:'2025', status:'obsolete', date:'2025-12-10', size:'180 KB' }
];
var votes = JSON.parse(localStorage.getItem('ln_votes') || 'null') || [
  { id:'v1', title:'Pintura de fachadas exteriores', description:'Esta de acuerdo con el cambio de color propuesto por el Comite?', options:['Si, apruebo','No, rechazo','Me abstendo'], status:'active', createdAt:'2026-04-01', votes:{'Si, apruebo':15,'No, rechazo':8,'Me abstendo':3}, voters:[] }
];
var isAdmin = false;
var chartInst = null;
var isResident = JSON.parse(sessionStorage.getItem('ln_resident') || 'null');

function save(k,v){ localStorage.setItem(k, JSON.stringify(v)); }

function esc(s){
  return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function toast(msg, ok){
  var t = document.createElement('div');
  t.style.cssText = 'position:fixed;bottom:22px;right:22px;background:'+(ok?'#16a34a':'#dc2626')+';color:#fff;padding:13px 22px;border-radius:13px;font-weight:600;z-index:9999;box-shadow:0 4px 16px rgba(0,0,0,.2);font-size:.9rem;transition:opacity .4s';
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(function(){ t.style.opacity='0'; setTimeout(function(){ t.remove(); },400); }, 2600);
}

/* ── RESIDENT AUTH ── */
function applyResidentUI(name, unit){
  var letter = name.trim().charAt(0).toUpperCase() || 'R';
  // Show all protected sections
  ['documentos','votaciones','contacto'].forEach(function(id){
    document.getElementById(id).style.display = 'block';
  });

  // User bars - DOCS
  document.getElementById('resAvatarLetter').textContent = letter;
  document.getElementById('resUserName').textContent = name;
  document.getElementById('resUserUnit').textContent = 'Unidad ' + unit;
  // User bars - VOTES
  document.getElementById('resAvatarVote').textContent = letter;
  document.getElementById('resUserNameVote').textContent = name;
  document.getElementById('resUserUnitVote').textContent = 'Unidad ' + unit;
  // PRE-FILL contact form
  var cName = document.getElementById('cName');
  var cUnit = document.getElementById('cUnit');
  if(cName) cName.value = name;
  if(cUnit) cUnit.value = unit;
}
function resLogin(name, unit){
  isResident = { name:name, unit:unit };
  sessionStorage.setItem('ln_resident', JSON.stringify(isResident));
  applyResidentUI(name, unit);
  renderDocs();
  renderVotes();
  closeModal('resLoginModal');
  toast('Bienvenido/a, ' + name.split(' ')[0] + '. Bienvenido al portal.', true);
  // Navigate to the section the user tried to access
  var dest = window._pendingNav || null;
  window._pendingNav = null;
  if (dest){
    setTimeout(function(){ navTo(dest); }, 350);
  }
}
window.resLogout = function(){
  isResident = null;
  sessionStorage.removeItem('ln_resident');
  ['documentos','votaciones','contacto'].forEach(function(id){
    document.getElementById(id).style.display = 'none';
  });

  window.scrollTo({ top: 0, behavior: 'smooth' });
  toast('Sesión cerrada. Hasta pronto.', true);
};
function checkResidentSession(){
  if (isResident){
    applyResidentUI(isResident.name, isResident.unit);
    renderDocs();
    renderVotes();
  }
}

/* RENDER POSTS */
function renderPosts(filter){
  filter = filter || 'all';
  var filtered = filter === 'all' ? posts
    : filter === 'urgent' ? posts.filter(function(p){ return p.urgent; })
    : posts.filter(function(p){ return p.category === filter; });
  var g = document.getElementById('postsGrid');
  if (!filtered.length){ g.innerHTML = '<p style="color:var(--slate);grid-column:1/-1">No hay avisos en esta categoria.</p>'; return; }
  g.innerHTML = filtered.map(function(p){
    return '<article class="post-card '+(p.urgent?'urgent':p.important?'important':'')+'">'
      +(p.urgent?'<span class="pbadge urgent">Urgente</span>':p.important?'<span class="pbadge important">Destacado</span>':'')
      +'<span class="pcat">'+esc(p.category)+'</span>'
      +'<h3>'+esc(p.title)+'</h3>'
      +'<p class="pmeta">&#128197; '+esc(p.date)+'</p>'
      +'<p class="pexcerpt">'+esc(p.excerpt)+'</p>'
      +'</article>';
  }).join('');
}

/* RENDER DOCS */
function renderDocs(){
  var term = document.getElementById('docSearch').value.toLowerCase();
  var cat  = document.getElementById('docCat').value;
  var year = document.getElementById('docYear').value;
  var filtered = docs.filter(function(d){
    return d.name.toLowerCase().indexOf(term) !== -1
      && (cat === 'all' || d.category === cat)
      && (year === 'all' || d.year === year);
  });
  var list = document.getElementById('docsList');
  if (!filtered.length){ list.innerHTML = '<p style="padding:22px;color:var(--slate)">No se encontraron documentos.</p>'; return; }
  list.innerHTML = filtered.map(function(d){
    return '<div class="doc-item">'
      +'<div class="dicon">&#128196;</div>'
      +'<div class="dinfo"><h4>'+esc(d.name)+'</h4><p class="dmeta">'+esc(d.category)+' &middot; '+esc(d.date)+' &middot; '+esc(d.size)+'</p></div>'
      +'<span class="dstatus '+d.status+'">'+(d.status==='current'?'Vigente':'Obsoleto')+'</span>'
      +'<button class="dbtn" onclick="alert(\'Descarga simulada.\')">Descargar</button>'
      +'</div>';
  }).join('');
}

/* RENDER VOTES */
function renderVotes(){
  var container = document.getElementById('pubVotes');
  var active = votes.filter(function(v){ return v.status === 'active'; });
  if (!active.length){ container.innerHTML = '<p style="color:var(--slate);grid-column:1/-1">No hay votaciones activas.</p>'; return; }
  container.innerHTML = active.map(function(v){
    var total = Object.values(v.votes).reduce(function(a,b){ return a+b; }, 0);
    return '<div class="vote-card">'
      +'<h4>'+esc(v.title)+'</h4>'
      +'<p class="vdesc">'+esc(v.description)+'</p>'
      +v.options.map(function(o){
        return '<label class="vopt"><input type="radio" name="v_'+v.id+'" value="'+esc(o)+'"> '+esc(o)+'</label>';
      }).join('')
      +'<div class="voter-row">'
      +'<input class="vinput" id="vn_'+v.id+'" placeholder="Su nombre">'
      +'<input class="vinput" id="vu_'+v.id+'" placeholder="N Unidad">'
      +'</div>'
      +'<div class="vact">'
      +'<button class="btn-vote" onclick="castVote(\''+v.id+'\')">Votar</button>'
      +'<button class="btn-res"  onclick="showResults(\''+v.id+'\')">Ver resultados</button>'
      +'</div>'
      +'<p class="vtotal">'+total+' voto'+(total!==1?'s':'')+' registrado'+(total!==1?'s':'')+'</p>'
      +'</div>';
  }).join('');
}

/* CAST VOTE */
window.castVote = function(id){
  var v = votes.find(function(x){ return x.id === id; });
  if (!v || v.status !== 'active'){ toast('Esta votacion no esta disponible.', false); return; }
  var sel = document.querySelector('input[name="v_'+id+'"]:checked');
  if (!sel){ toast('Seleccione una opcion antes de votar.', false); return; }
  var name = document.getElementById('vn_'+id).value.trim();
  var unit = document.getElementById('vu_'+id).value.trim();
  if (!name || !unit){ toast('Ingrese su nombre y numero de unidad.', false); return; }
  if (v.voters.some(function(x){ return x.unit === unit; })){ toast('La unidad '+unit+' ya emitio su voto.', false); return; }
  v.votes[sel.value] = (v.votes[sel.value] || 0) + 1;
  v.voters.push({name:name, unit:unit, option:sel.value, date:new Date().toISOString()});
  save('ln_votes', votes);
  renderVotes();
  if (isAdmin) renderAdmVotes();
  toast('Voto registrado exitosamente.', true);
};

/* SHOW RESULTS */
window.showResults = function(id){
  var v = votes.find(function(x){ return x.id === id; });
  if (!v) return;
  var total = Object.values(v.votes).reduce(function(a,b){ return a+b; }, 0);
  document.getElementById('resTitle').textContent = v.title;
  document.getElementById('resContent').innerHTML =
    '<p style="color:var(--slate);margin-bottom:18px">'+esc(v.description)+'</p>'
    +v.options.map(function(o){
      var count = v.votes[o] || 0;
      var pct = total ? (count/total*100).toFixed(1) : 0;
      return '<div class="rbar">'
        +'<div class="rbar-lbl"><span>'+esc(o)+'</span><span>'+count+' voto'+(count!==1?'s':'')+' ('+pct+'%)</span></div>'
        +'<div class="rbar-track"><div class="rbar-fill" style="width:'+pct+'%"></div></div>'
        +'</div>';
    }).join('')
    +'<p style="text-align:right;font-size:.8rem;color:var(--slate);margin-top:10px">Total: '+total+'</p>';
  openModal('resultModal');
  if (chartInst) chartInst.destroy();
  setTimeout(function(){
    var ctx = document.getElementById('voteChart');
    if (!ctx) return;
    chartInst = new Chart(ctx.getContext('2d'), {
      type:'bar',
      data:{ labels:v.options, datasets:[{ label:'Votos', data:v.options.map(function(o){ return v.votes[o]||0; }), backgroundColor:['#0b2b4a','#00b8d4','#64748b'], borderRadius:5 }] },
      options:{ plugins:{legend:{display:false}}, scales:{y:{beginAtZero:true, ticks:{stepSize:1}}} }
    });
  }, 120);
};

/* ADMIN RENDERS */
function renderAdmPosts(){
  document.getElementById('postsTB').innerHTML = posts.map(function(p){
    return '<tr><td>'+esc(p.title)+'</td><td>'+esc(p.category)+'</td><td>'+esc(p.date)+'</td>'
      +'<td>'+(p.urgent?'<span class="pbadge urgent">Urgente</span>':p.important?'<span class="pbadge important">Destacado</span>':'Normal')+'</td>'
      +'<td><button class="bedit" onclick="editPost(\''+p.id+'\')">Editar</button>'
      +'<button class="bdel" onclick="delPost(\''+p.id+'\')">Eliminar</button></td></tr>';
  }).join('');
}
function renderAdmDocs(){
  document.getElementById('docsTB').innerHTML = docs.map(function(d){
    return '<tr><td>'+esc(d.name)+'</td><td>'+esc(d.category)+'</td><td>'+esc(d.year)+'</td>'
      +'<td><span class="dstatus '+d.status+'">'+(d.status==='current'?'Vigente':'Obsoleto')+'</span></td>'
      +'<td><button class="bedit" onclick="editDoc(\''+d.id+'\')">Editar</button>'
      +'<button class="bdel" onclick="delDoc(\''+d.id+'\')">Eliminar</button></td></tr>';
  }).join('');
}
function renderAdmVotes(){
  document.getElementById('admVotesList').innerHTML = votes.map(function(v){
    var total = Object.values(v.votes).reduce(function(a,b){ return a+b; }, 0);
    return '<div class="avc">'
      +'<h3>'+esc(v.title)+' <span class="sbadge '+(v.status==='active'?'sact':'scls')+'">'+(v.status==='active'?'Activa':'Cerrada')+'</span></h3>'
      +'<p>'+esc(v.description)+'</p>'
      +'<p style="font-size:.8rem;color:var(--slate);margin-top:5px">Total: '+total+' voto'+(total!==1?'s':'')+'</p>'
      +'<div class="avc-foot">'
      +'<button class="bedit" onclick="showResults(\''+v.id+'\')">Resultados</button>'
      +'<button class="bedit" onclick="exportPDF(\''+v.id+'\')">PDF</button>'
      +'<button class="bedit" onclick="exportXLS(\''+v.id+'\')">Excel</button>'
      +'<button class="bedit" onclick="editVote(\''+v.id+'\')">Editar</button>'
      +'<button class="bdel"  onclick="delVote(\''+v.id+'\')">Eliminar</button>'
      +'</div>'
      +'<details class="voters-det"><summary>Votantes ('+v.voters.length+')</summary>'
      +'<ul>'+v.voters.map(function(x){ return '<li><strong>'+esc(x.name)+'</strong> - Unidad '+esc(x.unit)+' - '+esc(x.option)+' - '+(x.date||'').slice(0,10)+'</li>'; }).join('')+'</ul>'
      +'</details></div>';
  }).join('');
}

/* POST FORM */
function showPostForm(post){
  post = post || null;
  var fp = document.getElementById('postFP');
  fp.innerHTML =
    '<p class="fptitle">'+(post?'Editar':'Nueva')+' publicacion</p>'
    +'<input class="fpi" id="fp_t" placeholder="Titulo" value="'+esc(post&&post.title||'')+'">'
    +'<textarea class="fpi" id="fp_e" rows="3" placeholder="Resumen / contenido">'+esc(post&&post.excerpt||'')+'</textarea>'
    +'<div class="fprow">'
    +'<select class="fpi" id="fp_c">'+['reunion','mantenimiento','finanzas','seguridad'].map(function(c){ return '<option'+(post&&post.category===c?' selected':'')+'>'+c+'</option>'; }).join('')+'</select>'
    +'<input class="fpi" type="date" id="fp_d" value="'+(post&&post.date||new Date().toISOString().slice(0,10))+'">'
    +'</div>'
    +'<label class="fpchk"><input type="checkbox" id="fp_u"'+(post&&post.urgent?' checked':'')+'>  URGENTE</label>'
    +'<label class="fpchk"><input type="checkbox" id="fp_i"'+(post&&post.important?' checked':'')+'>  Destacado</label>'
    +'<div class="fpacts">'
    +'<button class="bsave" onclick="savePost(\''+(post&&post.id||'')+'\')">Guardar</button>'
    +'<button class="bcancel" onclick="closeFP(\'postFP\')">Cancelar</button>'
    +'</div>';
  fp.classList.add('open');
}
window.savePost = function(id){
  var title = document.getElementById('fp_t').value.trim();
  var excerpt = document.getElementById('fp_e').value.trim();
  if (!title){ toast('El titulo es obligatorio.', false); return; }
  var obj = { id:id||'p'+Date.now(), title:title, excerpt:excerpt,
    category:document.getElementById('fp_c').value,
    date:document.getElementById('fp_d').value,
    urgent:document.getElementById('fp_u').checked,
    important:document.getElementById('fp_i').checked };
  if (id){ posts = posts.map(function(p){ return p.id===id?obj:p; }); }
  else { posts.push(obj); }
  save('ln_posts', posts); renderPosts(); renderAdmPosts(); closeFP('postFP');
  toast('Publicacion guardada.', true);
};
window.editPost = function(id){ showPostForm(posts.find(function(p){ return p.id===id; })); };
window.delPost  = function(id){
  if (!confirm('Eliminar esta publicacion?')) return;
  posts = posts.filter(function(p){ return p.id!==id; });
  save('ln_posts', posts); renderPosts(); renderAdmPosts();
};

/* DOC FORM */
function showDocForm(doc){
  doc = doc || null;
  var fp = document.getElementById('docFP');
  fp.innerHTML =
    '<p class="fptitle">'+(doc?'Editar':'Registrar')+' documento</p>'
    +'<input class="fpi" type="file" id="fp_file" accept=".pdf,.doc,.docx">'
    +'<input class="fpi" id="fp_dn" placeholder="Nombre del documento" value="'+esc(doc&&doc.name||'')+'">'
    +'<div class="fprow">'
    +'<select class="fpi" id="fp_dc">'+['actas','finanzas','reglamentos','emergencia','planos'].map(function(c){ return '<option'+(doc&&doc.category===c?' selected':'')+'>'+c+'</option>'; }).join('')+'</select>'
    +'<select class="fpi" id="fp_dy"><option'+(doc&&doc.year==='2026'?' selected':'')+'>2026</option><option'+(doc&&doc.year==='2025'?' selected':'')+'>2025</option></select>'
    +'</div>'
    +'<div class="fprow">'
    +'<select class="fpi" id="fp_ds"><option value="current"'+(doc&&doc.status!=='obsolete'?' selected':'')+'>Vigente</option><option value="obsolete"'+(doc&&doc.status==='obsolete'?' selected':'')+'>Obsoleto</option></select>'
    +'<input class="fpi" type="date" id="fp_dd" value="'+(doc&&doc.date||new Date().toISOString().slice(0,10))+'">'
    +'</div>'
    +'<div class="fpacts">'
    +'<button class="bsave" onclick="saveDoc(\''+(doc&&doc.id||'')+'\')">Guardar</button>'
    +'<button class="bcancel" onclick="closeFP(\'docFP\')">Cancelar</button>'
    +'</div>';
  fp.classList.add('open');
  document.getElementById('fp_file').addEventListener('change', function(){
    if (this.files[0]) document.getElementById('fp_dn').value = this.files[0].name;
  });
}
window.saveDoc = function(id){
  var name = document.getElementById('fp_dn').value.trim();
  if (!name){ toast('El nombre es obligatorio.', false); return; }
  var fi = document.getElementById('fp_file');
  var size = fi&&fi.files[0] ? (fi.files[0].size/1024).toFixed(0)+' KB' : (docs.find(function(d){ return d.id===id; })||{}).size || '-';
  var obj = { id:id||'d'+Date.now(), name:name, size:size,
    category:document.getElementById('fp_dc').value,
    year:document.getElementById('fp_dy').value,
    status:document.getElementById('fp_ds').value,
    date:document.getElementById('fp_dd').value };
  if (id){ docs = docs.map(function(d){ return d.id===id?obj:d; }); }
  else { docs.push(obj); }
  save('ln_docs', docs); renderDocs(); renderAdmDocs(); closeFP('docFP');
  toast('Documento guardado.', true);
};
window.editDoc = function(id){ showDocForm(docs.find(function(d){ return d.id===id; })); };
window.delDoc  = function(id){
  if (!confirm('Eliminar este documento?')) return;
  docs = docs.filter(function(d){ return d.id!==id; });
  save('ln_docs', docs); renderDocs(); renderAdmDocs();
};

/* VOTE FORM */
function showVoteForm(vote){
  vote = vote || null;
  var fp = document.getElementById('voteFP');
  var defOpts = vote && vote.options ? vote.options : ['Si, apruebo','No, rechazo'];
  fp.innerHTML =
    '<p class="fptitle">'+(vote?'Editar':'Nueva')+' votacion</p>'
    +'<input class="fpi" id="fp_vt" placeholder="Titulo" value="'+esc(vote&&vote.title||'')+'">'
    +'<textarea class="fpi" id="fp_vd" rows="2" placeholder="Descripcion">'+esc(vote&&vote.description||'')+'</textarea>'
    +'<p style="font-size:.82rem;color:var(--slate);margin-bottom:8px">Opciones (minimo 2):</p>'
    +'<div id="optList">'+defOpts.map(function(o,i){ return '<div style="display:flex;gap:8px;margin-bottom:8px"><input class="fpi opt-inp" style="margin:0" value="'+esc(o)+'" placeholder="Opcion '+(i+1)+'"><button onclick="this.parentNode.remove()" style="background:#fee2e2;color:var(--danger);border:none;border-radius:8px;padding:0 12px;flex-shrink:0">x</button></div>'; }).join('')+'</div>'
    +'<button type="button" style="background:var(--light);border:1px dashed var(--border);padding:8px 15px;border-radius:8px;font-size:.83rem;margin-bottom:12px" onclick="addOpt()">+ Agregar opcion</button>'
    +'<select class="fpi" id="fp_vs"><option value="active"'+(vote&&vote.status!=='closed'?' selected':'')+'>Activa</option><option value="closed"'+(vote&&vote.status==='closed'?' selected':'')+'>Cerrada</option></select>'
    +'<div class="fpacts">'
    +'<button class="bsave" onclick="saveVote(\''+(vote&&vote.id||'')+'\')">Guardar</button>'
    +'<button class="bcancel" onclick="closeFP(\'voteFP\')">Cancelar</button>'
    +'</div>';
  fp.classList.add('open');
}
window.addOpt = function(){
  var d = document.createElement('div');
  d.style = 'display:flex;gap:8px;margin-bottom:8px';
  var n = document.getElementById('optList').children.length + 1;
  d.innerHTML = '<input class="fpi opt-inp" style="margin:0" placeholder="Opcion '+n+'"><button onclick="this.parentNode.remove()" style="background:#fee2e2;color:var(--danger);border:none;border-radius:8px;padding:0 12px;flex-shrink:0">x</button>';
  document.getElementById('optList').appendChild(d);
};
window.saveVote = function(id){
  var title = document.getElementById('fp_vt').value.trim();
  var desc  = document.getElementById('fp_vd').value.trim();
  var opts  = Array.from(document.querySelectorAll('.opt-inp')).map(function(i){ return i.value.trim(); }).filter(Boolean);
  if (!title || opts.length < 2){ toast('Titulo y al menos 2 opciones requeridos.', false); return; }
  var status = document.getElementById('fp_vs').value;
  var existing = votes.find(function(v){ return v.id===id; });
  var vobj = {}; opts.forEach(function(o){ vobj[o] = existing&&existing.votes[o] || 0; });
  var obj = { id:id||'v'+Date.now(), title:title, description:desc, options:opts, status:status,
    createdAt: existing&&existing.createdAt || new Date().toISOString().slice(0,10),
    votes:vobj, voters: existing&&existing.voters || [] };
  if (id){ votes = votes.map(function(v){ return v.id===id?obj:v; }); }
  else { votes.push(obj); }
  save('ln_votes', votes); renderAdmVotes(); renderVotes(); closeFP('voteFP');
  toast('Votacion guardada.', true);
};
