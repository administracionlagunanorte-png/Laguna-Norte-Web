document.getElementById('resLoginSubmit').addEventListener('click', function(){
  var email = document.getElementById('resEmail').value.trim().toLowerCase();
  var pin   = getPIN();
  var err   = document.getElementById('resLoginErr');
  err.innerHTML = '';
  document.getElementById('resEmail').classList.remove('err');

  if (!email){
    document.getElementById('resEmail').classList.add('err');
    err.innerHTML = '⚠️ Ingresa tu correo electrónico.';
    return;
  }
  if (pin.length < 4){
    err.innerHTML = '⚠️ Ingresa tu PIN de 4 dígitos.';
    shakePIN(); return;
  }

  var resident = residents.find(function(r){ return r.email === email; });
  if (!resident){
    document.getElementById('resEmail').classList.add('err');
    err.innerHTML = '⚠️ Correo no encontrado. ¿Ya te registraste?';
    return;
  }
  if (resident.status === 'pending'){
    err.innerHTML = '⏳ Tu solicitud aún está pendiente de aprobación por la administración.';
    clearPIN(); return;
  }
  if (resident.status === 'blocked'){
    err.innerHTML = '🚫 Tu acceso ha sido bloqueado. Contacta a la administración.';
    clearPIN(); return;
  }
  if (resident.pin !== pin){
    err.innerHTML = '⚠️ PIN incorrecto.';
    clearPIN(); shakePIN();
    document.getElementById('pin1').focus(); return;
  }

  // Success
  var btn = document.getElementById('resLoginSubmit');
  btn.textContent = 'Verificando...'; btn.classList.add('loading');
  setTimeout(function(){
    btn.textContent = 'Ingresar al portal'; btn.classList.remove('loading');
    err.innerHTML = '';
    document.getElementById('resEmail').classList.remove('err');
    clearPIN();
    resLogin(resident.nombre + ' ' + resident.apellido, resident.casa);
  }, 600);
});
