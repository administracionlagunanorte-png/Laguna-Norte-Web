<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Portal · Condominio Laguna Norte</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<style>
:root{--navy:#0b2b4a;--navy2:#0e3a63;--teal:#00b8d4;--teal2:#00d4f5;--white:#fff;--light:#f0f6ff;--slate:#64748b;--text:#1e293b;--border:#e2e8f0;--danger:#dc2626;--success:#16a34a;--warn:#d97706;--radius:18px;--shadow:0 4px 24px rgba(11,43,74,.10)}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'DM Sans',sans-serif;background:var(--light);color:var(--text);line-height:1.6}
img{display:block;max-width:100%}a{text-decoration:none;color:inherit}button{cursor:pointer;font-family:inherit;border:none}
.container{max-width:1280px;margin:0 auto;padding:0 24px}
.site-header{background:rgba(11,43,74,.97);backdrop-filter:blur(10px);color:#fff;padding:12px 0;position:sticky;top:0;z-index:100;border-bottom:1px solid rgba(0,184,212,.3)}
.hdr{display:flex;align-items:center;justify-content:space-between;gap:12px}
.logo-wrap{display:flex;align-items:center;gap:12px;flex-shrink:0}
.logo-img{width:48px;height:48px;border-radius:12px;object-fit:contain;background:#fff;padding:4px}
.logo-name{font-family:'Playfair Display',serif;font-size:1.2rem;color:#fff;line-height:1.2}
.logo-sub{font-size:.72rem;color:rgba(255,255,255,.6);letter-spacing:.03em}
nav.nav-links{display:flex;gap:4px}
nav.nav-links a{color:rgba(255,255,255,.85);font-size:.85rem;font-weight:500;padding:7px 12px;border-radius:30px;transition:all .2s;white-space:nowrap}
nav.nav-links a:hover{background:rgba(0,184,212,.25);color:#fff}
.btn-admin{background:linear-gradient(135deg,var(--teal),var(--teal2));color:var(--navy);font-weight:700;font-size:.82rem;padding:9px 16px;border-radius:30px;display:flex;align-items:center;gap:7px;transition:transform .18s,box-shadow .18s;flex-shrink:0}
.btn-admin:hover{transform:translateY(-1px);box-shadow:0 4px 16px rgba(0,184,212,.45)}

.hero{position:relative;height:90vh;min-height:520px;max-height:760px;overflow:hidden;display:flex;align-items:flex-end}
.hero-bg{position:absolute;inset:0;background-image:url('data:image/jpeg;base64,');background-size:cover;background-position:center 30%;animation:hz 20s ease-in-out infinite alternate}
@keyframes hz{from{transform:scale(1.03)}to{transform:scale(1.09)}}

.hero-ov{position:absolute;inset:0;background:linear-gradient(to top,rgba(11,43,74,.88) 0%,rgba(11,43,74,.25) 55%,transparent 100%)}
.hero-body{position:relative;z-index:2;padding:0 0 56px;width:100%}
.hero-tag{display:inline-flex;align-items:center;gap:7px;background:rgba(0,184,212,.18);border:1px solid rgba(0,184,212,.45);color:var(--teal2);font-size:.78rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:5px 14px;border-radius:30px;margin-bottom:14px}
.hero h1{font-family:'Playfair Display',serif;font-size:clamp(2.2rem,5.5vw,3.9rem);color:#fff;line-height:1.1;margin-bottom:10px}
.hero h1 span{color:var(--teal2)}
.hero-sub{color:rgba(255,255,255,.72);font-size:1rem;max-width:480px;margin-bottom:26px}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap}
.btn-p{background:var(--teal);color:var(--navy);font-weight:700;padding:12px 26px;border-radius:40px;font-size:.92rem;transition:transform .18s,box-shadow .18s}
.btn-p:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(0,184,212,.5)}
.btn-o{background:transparent;color:#fff;font-weight:600;padding:12px 26px;border-radius:40px;border:2px solid rgba(255,255,255,.5);font-size:.92rem;transition:all .2s}
.btn-o:hover{background:rgba(255,255,255,.12);border-color:#fff}
.hero-stats{display:flex;gap:36px;margin-top:32px;flex-wrap:wrap}
.stat-num{font-family:'Playfair Display',serif;font-size:1.9rem;color:var(--teal2);line-height:1}
.stat-lbl{font-size:.72rem;color:rgba(255,255,255,.55);text-transform:uppercase;letter-spacing:.06em}
.sec{padding:64px 0}.sec-alt{background:#fff}
.eyebrow{color:var(--teal);font-size:.78rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;margin-bottom:8px;display:block}
.sec-title{font-family:'Playfair Display',serif;font-size:1.9rem;color:var(--navy);line-height:1.2;margin-bottom:6px}
.sec-sub{color:var(--slate);max-width:500px}.sec-hdr{margin-bottom:36px}
.gal{display:grid;grid-template-columns:1.5fr 1fr;grid-template-rows:260px 260px 260px;gap:16px;margin-bottom:40px}
.gcell{border-radius:var(--radius);overflow:hidden;position:relative}
.gcell img{width:100%;height:100%;object-fit:cover;transition:transform .5s;image-rendering:-webkit-optimize-contrast;image-rendering:crisp-edges}
.gcell:hover img{transform:scale(1.06)}.gcell.tall{grid-row:1/4}
.gcap{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(to top,rgba(11,43,74,.82),transparent);color:#fff;padding:14px 16px 12px;font-size:.83rem;font-weight:500;opacity:0;transition:opacity .3s}
.gcell:hover .gcap{opacity:1}
.loc-detail{display:flex;gap:12px;align-items:flex-start;padding:14px 0;border-bottom:1px solid var(--border)}
.loc-icon{width:42px;height:42px;border-radius:11px;background:linear-gradient(135deg,var(--navy),var(--navy2));display:flex;align-items:center;justify-content:center;font-size:1rem;flex-shrink:0}
.loc-detail h4{font-weight:600;font-size:.88rem;color:var(--navy)}.loc-detail p{font-size:.83rem;color:var(--slate);margin-top:2px}
.filters{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:28px}
.chip{background:#fff;border:1px solid var(--border);color:var(--slate);font-size:.83rem;font-weight:500;padding:7px 16px;border-radius:30px;transition:all .2s}
.chip:hover,.chip.active{background:var(--navy);color:#fff;border-color:var(--navy)}
.posts-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:20px}
.post-card{background:#fff;border-radius:var(--radius);padding:22px;border-left:4px solid var(--border);box-shadow:var(--shadow);transition:transform .2s,box-shadow .2s;position:relative}
.post-card:hover{transform:translateY(-3px);box-shadow:0 8px 28px rgba(0,0,0,.10)}
.post-card.urgent{border-left-color:var(--danger)}.post-card.important{border-left-color:var(--warn)}
.pbadge{position:absolute;top:14px;right:14px;padding:3px 10px;border-radius:20px;font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em}
.pbadge.urgent{background:#fee2e2;color:var(--danger)}.pbadge.important{background:#fef3c7;color:var(--warn)}
.pcat{font-size:.73rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--teal);margin-bottom:7px;display:block}
.post-card h3{font-weight:600;font-size:.95rem;color:var(--navy);margin-bottom:5px;line-height:1.4}
.pmeta{font-size:.78rem;color:var(--slate);margin-bottom:8px}.pexcerpt{font-size:.86rem;color:var(--slate);line-height:1.6}
.doc-ctrl{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:24px;align-items:center}
.sinput{flex:1;min-width:200px;padding:10px 16px;border:1px solid var(--border);border-radius:30px;font-size:.88rem;outline:none;transition:border-color .2s}
.sinput:focus{border-color:var(--teal)}
.sselect{padding:10px 14px;border:1px solid var(--border);border-radius:30px;font-size:.84rem;outline:none;background:#fff}
.docs-list{background:#fff;border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow)}
.doc-item{display:flex;align-items:center;gap:14px;padding:16px 22px;border-bottom:1px solid var(--light);transition:background .2s}
.doc-item:hover{background:var(--light)}.doc-item:last-child{border-bottom:none}
.dicon{width:42px;height:42px;border-radius:10px;background:linear-gradient(135deg,#fee2e2,#fca5a5);display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0}
.dinfo{flex:1;min-width:0}.dinfo h4{font-weight:600;font-size:.9rem;color:var(--navy);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.dmeta{font-size:.76rem;color:var(--slate);margin-top:2px}
.dstatus{padding:3px 10px;border-radius:20px;font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em;flex-shrink:0}
.dstatus.current{background:#dcfce7;color:var(--success)}.dstatus.obsolete{background:#f1f5f9;color:var(--slate)}
.dbtn{background:var(--navy);color:#fff;font-size:.78rem;font-weight:600;padding:7px 14px;border-radius:20px;transition:background .2s;flex-shrink:0}
.dbtn:hover{background:var(--navy2)}
.votes-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:20px}
.vote-card{background:#fff;border-radius:var(--radius);padding:26px;box-shadow:var(--shadow)}
.vote-card h4{font-family:'Playfair Display',serif;font-size:1.15rem;color:var(--navy);margin-bottom:7px}
.vdesc{font-size:.88rem;color:var(--slate);margin-bottom:18px}
.vopt{display:flex;align-items:center;gap:11px;padding:11px 14px;border-radius:11px;border:2px solid var(--border);margin-bottom:9px;cursor:pointer;transition:all .2s;font-size:.88rem}
.vopt:hover{border-color:var(--teal);background:rgba(0,184,212,.05)}.vopt input{accent-color:var(--teal);width:17px;height:17px;flex-shrink:0}
.voter-row{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin:14px 0}
.vinput{padding:10px 13px;border:1px solid var(--border);border-radius:10px;font-size:.86rem;outline:none;transition:border-color .2s;width:100%}
.vinput:focus{border-color:var(--teal)}
.vact{display:flex;gap:9px;margin-top:4px}
.btn-vote{flex:1;background:var(--navy);color:#fff;font-weight:600;padding:11px;border-radius:10px;transition:background .2s}
.btn-vote:hover{background:var(--navy2)}
.btn-res{flex:1;background:var(--light);color:var(--navy);font-weight:600;padding:11px;border-radius:10px;transition:background .2s}
.btn-res:hover{background:var(--border)}.vtotal{text-align:center;font-size:.78rem;color:var(--slate);margin-top:12px}
.rbar{margin-bottom:13px}.rbar-lbl{display:flex;justify-content:space-between;font-size:.83rem;font-weight:500;margin-bottom:4px}
.rbar-track{height:9px;background:var(--border);border-radius:4px;overflow:hidden}
.rbar-fill{height:100%;background:linear-gradient(90deg,var(--teal),var(--navy));border-radius:4px;transition:width .7s ease}
.contact-wrap{background:linear-gradient(135deg,var(--navy),var(--navy2));border-radius:26px;padding:52px 48px;text-align:center}
.ctitle{font-family:'Playfair Display',serif;font-size:1.9rem;color:#fff;margin-bottom:7px}
.csub{color:rgba(255,255,255,.6);margin-bottom:32px}
.cform{max-width:680px;margin:0 auto;text-align:left}
.crow{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px}
.cinput{width:100%;padding:13px 17px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);border-radius:13px;color:#fff;font-size:.9rem;font-family:inherit;outline:none;transition:border-color .2s}
.cinput::placeholder{color:rgba(255,255,255,.4)}.cinput:focus{border-color:var(--teal)}.cinput option{background:var(--navy)}
.cmb{margin-bottom:14px}
.btn-send{width:100%;background:var(--teal);color:var(--navy);font-weight:700;font-size:.95rem;padding:14px;border-radius:13px;transition:transform .18s,box-shadow .18s;margin-top:4px}
.btn-send:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(0,184,212,.45)}
.cmsg{padding:11px 15px;border-radius:11px;margin-bottom:14px;font-size:.86rem;display:none}
.cmsg.ok{background:rgba(22,163,74,.2);color:#4ade80;display:block}.cmsg.err{background:rgba(220,38,38,.2);color:#f87171;display:block}
.site-footer{background:var(--navy);color:rgba(255,255,255,.55);padding:24px 0;text-align:center;font-size:.83rem}
.site-footer b{color:var(--teal)}
/* RESIDENT AUTH */

.res-user-bar{display:flex;align-items:center;justify-content:space-between;background:var(--light);border-radius:12px;padding:12px 18px;margin-bottom:22px;flex-wrap:wrap;gap:10px}
.res-user-info{display:flex;align-items:center;gap:10px}
.res-avatar{width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,var(--navy),var(--teal));display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:1rem}
.res-user-name{font-weight:600;color:var(--navy);font-size:.9rem}
.res-user-unit{font-size:.78rem;color:var(--slate)}
.btn-res-logout{background:#fee2e2;color:var(--danger);padding:7px 16px;border-radius:20px;font-weight:600;font-size:.8rem}
.mres-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px}
.mres-hint{font-size:.78rem;color:var(--slate);margin-top:-4px;margin-bottom:12px;text-align:center}

/* PROFESSIONAL RESIDENT LOGIN */
.rmodal-overlay{display:none;position:fixed;inset:0;z-index:300;align-items:center;justify-content:center}
.rmodal-overlay.open{display:flex}
.rmodal-bg{position:absolute;inset:0;background:rgba(7,22,38,.75);backdrop-filter:blur(8px)}
.rmodal-card{position:relative;z-index:1;display:flex;border-radius:28px;overflow:hidden;width:90%;max-width:860px;min-height:520px;box-shadow:0 32px 80px rgba(0,0,0,.45);animation:rsu .35s cubic-bezier(.22,1,.36,1)}
@keyframes rsu{from{transform:translateY(28px) scale(.97);opacity:0}to{transform:none;opacity:1}}
.rmodal-left{flex:1;background:linear-gradient(160deg,#071626 0%,#0b2b4a 45%,#0e3a63 100%);padding:48px 40px;display:flex;flex-direction:column;justify-content:space-between;position:relative;overflow:hidden;min-width:300px}
.rmodal-left::before{content:'';position:absolute;top:-80px;right:-80px;width:280px;height:280px;border-radius:50%;background:radial-gradient(circle,rgba(0,184,212,.25),transparent 70%)}
.rmodal-left::after{content:'';position:absolute;bottom:-60px;left:-60px;width:200px;height:200px;border-radius:50%;background:radial-gradient(circle,rgba(0,212,245,.12),transparent 70%)}
.rml-logo{display:flex;align-items:center;gap:12px;position:relative;z-index:1}
.rml-logo img{width:52px;height:52px;border-radius:14px;object-fit:contain;background:#fff;padding:5px}
.rml-logo-name{font-family:'Playfair Display',serif;font-size:1.1rem;color:#fff;line-height:1.2}
.rml-logo-sub{font-size:.7rem;color:rgba(255,255,255,.5);letter-spacing:.04em}
.rml-body{position:relative;z-index:1}
.rml-title{font-family:'Playfair Display',serif;font-size:2rem;color:#fff;line-height:1.2;margin-bottom:14px}
.rml-title span{color:var(--teal2)}
.rml-desc{font-size:.88rem;color:rgba(255,255,255,.6);line-height:1.7;margin-bottom:28px}
.rml-features{list-style:none;padding:0}
.rml-features li{display:flex;align-items:center;gap:10px;font-size:.83rem;color:rgba(255,255,255,.7);padding:7px 0;border-bottom:1px solid rgba(255,255,255,.07)}
.rml-features li:last-child{border:none}
.rml-features li::before{content:'';width:20px;height:20px;border-radius:50%;background:linear-gradient(135deg,var(--teal),var(--teal2));display:flex;align-items:center;justify-content:center;flex-shrink:0}
.rml-dot{width:6px;height:6px;background:var(--teal2);border-radius:50%;flex-shrink:0}
.rml-footer{font-size:.72rem;color:rgba(255,255,255,.3);position:relative;z-index:1}
.rmodal-right{width:380px;background:#fff;padding:48px 40px;display:flex;flex-direction:column;justify-content:center}
.rmr-title{font-family:'Playfair Display',serif;font-size:1.6rem;color:var(--navy);margin-bottom:6px}
.rmr-sub{font-size:.85rem;color:var(--slate);margin-bottom:32px;line-height:1.5}
.rfield{margin-bottom:18px}
.rfield label{display:block;font-size:.78rem;font-weight:700;color:var(--navy);letter-spacing:.05em;text-transform:uppercase;margin-bottom:7px}
.rfield-wrap{position:relative}
.rfield-icon{position:absolute;left:14px;top:50%;transform:translateY(-50%);font-size:1rem;pointer-events:none;color:var(--slate)}
.rinput{width:100%;padding:13px 16px 13px 42px;border:1.5px solid var(--border);border-radius:12px;font-size:.92rem;font-family:inherit;outline:none;color:var(--text);transition:border-color .2s,box-shadow .2s;background:#fafbff}
.rinput:focus{border-color:var(--teal);box-shadow:0 0 0 3px rgba(0,184,212,.12);background:#fff}
.rinput.error{border-color:var(--danger);box-shadow:0 0 0 3px rgba(220,38,38,.1)}
.rrow{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.rpin-wrap{display:flex;gap:10px;justify-content:center;margin-bottom:4px}
.rpin-input{width:52px;height:60px;border:1.5px solid var(--border);border-radius:12px;font-size:1.5rem;font-weight:700;text-align:center;outline:none;color:var(--navy);background:#fafbff;transition:border-color .2s,box-shadow .2s;-webkit-text-security:disc}
.rpin-input:focus{border-color:var(--teal);box-shadow:0 0 0 3px rgba(0,184,212,.12);background:#fff}
.rpin-input.filled{border-color:var(--teal);background:#f0fdff}
.rpin-input.error{border-color:var(--danger)}
.rerr{color:var(--danger);font-size:.82rem;margin-bottom:14px;min-height:20px;display:flex;align-items:center;gap:6px}
.btn-rlogin{width:100%;background:linear-gradient(135deg,var(--navy),var(--navy2));color:#fff;font-weight:700;padding:15px;border-radius:12px;border:none;font-size:.95rem;font-family:inherit;cursor:pointer;transition:transform .18s,box-shadow .18s;position:relative;overflow:hidden}
.btn-rlogin::after{content:'';position:absolute;inset:0;background:linear-gradient(135deg,transparent,rgba(0,184,212,.25));opacity:0;transition:opacity .2s}
.btn-rlogin:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(11,43,74,.4)}
.btn-rlogin:hover::after{opacity:1}
.btn-rlogin:active{transform:translateY(0)}
.btn-rlogin.loading{pointer-events:none;opacity:.8}
.rclose{position:absolute;top:18px;right:18px;z-index:10;width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.15);border:none;color:#fff;font-size:1.1rem;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .2s}
.rclose:hover{background:rgba(255,255,255,.25)}
.porteria-grid{grid-template-columns:1fr}}
.rpin-hint{font-size:.75rem;color:var(--slate);text-align:center;margin-bottom:20px}

/* EMAILJS CONFIG */
.ejs-config-box{background:#fef9ec;border:1px solid #fde68a;border-radius:14px;padding:20px;margin-bottom:20px}
.ejs-config-box h4{font-weight:700;color:#92400e;font-size:.88rem;margin-bottom:4px}
.ejs-config-box p{font-size:.79rem;color:#78350f;margin-bottom:10px;line-height:1.5}
.ejs-input{padding:9px 13px;border:1.5px solid #fde68a;border-radius:9px;font-size:.86rem;outline:none;background:#fffdf5;color:var(--text);font-family:inherit}
.ejs-input:focus{border-color:#d97706}
.btn-ejs-save{background:#d97706;color:#fff;font-weight:700;padding:9px 20px;border-radius:9px;font-size:.84rem}
.btn-ejs-save:hover{background:#b45309}
.ejs-status{font-size:.78rem;margin-top:8px;font-weight:600}
.ejs-status.ok{color:var(--success)}.ejs-status.err{color:var(--danger)}

/* RESIDENT AUTH TABS */
.rauth-tabs{display:flex;background:#f0f4f8;border-radius:12px;padding:4px;margin-bottom:28px;gap:4px}
.rauth-tab{flex:1;padding:9px;border:none;background:transparent;border-radius:9px;font-size:.85rem;font-weight:600;color:var(--slate);cursor:pointer;transition:all .2s;font-family:inherit}
.rauth-tab.active{background:#fff;color:var(--navy);box-shadow:0 2px 8px rgba(0,0,0,.08)}
.rauth-pane{display:none}.rauth-pane.active{display:block}
.rfield-full{margin-bottom:16px}
.rfield-full label{display:block;font-size:.75rem;font-weight:700;color:var(--navy);letter-spacing:.05em;text-transform:uppercase;margin-bottom:6px}
.rfield-full .rfield-wrap{position:relative}
.rfield-full .rfield-icon{position:absolute;left:13px;top:50%;transform:translateY(-50%);font-size:.9rem;color:var(--slate);pointer-events:none}
.rfield-full .rinput{width:100%;padding:12px 15px 12px 40px;border:1.5px solid var(--border);border-radius:11px;font-size:.9rem;font-family:inherit;outline:none;color:var(--text);background:#fafbff;transition:border-color .2s,box-shadow .2s}
.rfield-full .rinput:focus{border-color:var(--teal);box-shadow:0 0 0 3px rgba(0,184,212,.1)}
.rfield-full .rinput.err{border-color:var(--danger);box-shadow:0 0 0 3px rgba(220,38,38,.08)}
