/* PIN INPUTS - auto-advance and handle backspace */
(function(){
  var pins = ['pin1','pin2','pin3','pin4'];
  pins.forEach(function(id, i){
    var el = document.getElementById(id);
    if (!el) return;
    el.addEventListener('input', function(){
      this.value = this.value.replace(/[^0-9]/g,'').slice(-1);
      if (this.value && i < pins.length-1){ document.getElementById(pins[i+1]).focus(); }
      this.classList.toggle('filled', !!this.value);
    });
    el.addEventListener('keydown', function(e){
      if (e.key === 'Backspace' && !this.value && i > 0){ document.getElementById(pins[i-1]).focus(); }
      if (e.key === 'Enter') document.getElementById('resLoginSubmit').click();
    });
    el.addEventListener('paste', function(e){
      e.preventDefault();
      var paste = (e.clipboardData||window.clipboardData).getData('text').replace(/[^0-9]/g,'').slice(0,4);
      paste.split('').forEach(function(ch, j){
        if (j < pins.length){ var inp=document.getElementById(pins[j]); inp.value=ch; inp.classList.add('filled'); }
      });
      if (paste.length < pins.length) document.getElementById(pins[Math.min(paste.length,pins.length-1)]).focus();
    });
  });
})();
function getPIN(){ return ['pin1','pin2','pin3','pin4'].map(function(id){ return document.getElementById(id).value; }).join(''); }
function clearPIN(){ ['pin1','pin2','pin3','pin4'].forEach(function(id){ var el=document.getElementById(id); if(el){el.value='';el.classList.remove('filled','error');} }); }
function shakePIN(){ ['pin1','pin2','pin3','pin4'].forEach(function(id){ var el=document.getElementById(id); if(el)el.classList.add('error'); }); setTimeout(function(){ ['pin1','pin2','pin3','pin4'].forEach(function(id){ var el=document.getElementById(id); if(el)el.classList.remove('error'); }); }, 600); }

